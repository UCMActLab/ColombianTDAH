        <ui:VisualElement name="Fase3" class="faseBg" style="flex-grow: 1; width: 60%; height: auto; flex-wrap: wrap; justify-content: space-around;">
            <ui:VisualElement name="A" style="flex-grow: 1; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgba(255, 121, 121, 0); justify-content: flex-start;">
                <ui:Label text="Espaciado de eventos:" name="Titulo" />
                <ui:Label text="Entre cada cuantos segundos pasarán las cosas en la escena." name="Explicacion" />
                <ui:VisualElement style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Label text="Cada cuanto aparecen troncos en el rio (entre 3 y 20 segundos)" name="expl" style="flex-direction: column;" />
                    <ui:IntegerField label="min" value="3" />
                    <ui:IntegerField label="max" value="20" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Label text="Cada cuantos segundoss salta un delfín (entre 2 y 10):" name="expl" style="flex-direction: column;" />
                    <ui:IntegerField label="min" value="2" />
                    <ui:IntegerField label="max" value="10" />
                </ui:VisualElement>
                <ui:Toggle label="Piruetas simultaneas??" name="Toggle" />
                <ui:VisualElement style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Label text="Cada cuantos saltos es pirueta (entre 2 y 10):                                         ." name="expl" style="flex-direction: column;" />
                    <ui:IntegerField label="min" value="2" />
                    <ui:IntegerField label="max" value="10" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="B" style="flex-grow: 1; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgba(255, 121, 121, 0); justify-content: flex-start;">
                <ui:FloatField label="Velocidad de obstaculos: (entre 0.1 y 20)" value="2.5" />
            </ui:VisualElement>
            <ui:VisualElement name="C" style="flex-grow: 1; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgba(255, 121, 121, 0); justify-content: flex-start; flex-wrap: wrap; flex-direction: row;">
                <ui:IntegerField label="Puntuacion max:" value="42" />
