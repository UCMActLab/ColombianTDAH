    <Style src="project://database/Assets/Scripts/configUi/configUi.uss?fileID=7433441132597879392&amp;guid=bd014f9788e6ad84ea62ed986ccff74e&amp;type=3#configUi" />
    <ui:VisualElement name="UiDoc" style="flex-grow: 1; flex-direction: row; background-color: rgb(0, 138, 17);">
        <ui:VisualElement name="Fase1y2" style="flex-grow: 1; flex-direction: column; width: 40%; height: 100%;">
            <ui:VisualElement name="Fase1" class="faseBg" style="flex-grow: 1;">
                <ui:IntegerField label="Cant carriles:" value="3" />
                <ui:IntegerField label="Cant delf:" value="5" />
                <ui:Button text="Aceptar" />
                <ui:Label text="(al pulsar este botón se recargará &#10;la cuadrícula de abajo, cuidado &#10;con los cambios que hayas hecho!)" style="flex-wrap: wrap;" />
            </ui:VisualElement>
            <ui:VisualElement name="Fase2" class="faseBg" style="flex-grow: 1; flex-wrap: wrap; flex-direction: row; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;">
                <ui:Label text="Superficie del rio:                                       ." />
