<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <engine:VisualElement name="root" style="flex-direction: column; padding: 10px; gap: 10px; flex-grow: 1; height: 100%; background-image: resource(&apos;UI/hoja-papel-rayada-ancha-cuaderno_696657-12814&apos;);">
        <engine:Label text="Equilibrio Terapéutico" style="unity-text-align: middle-center; font-size: 24px; unity-font-style: bold;" />
        <engine:VisualElement name="row-container" style="flex-direction: row; justify-content: space-between; gap: 40px; flex-grow: 1;">
            <engine:VisualElement name="jornada-panel" style="flex-direction: column; flex-grow: 1;">
                <engine:VisualElement name="toolbar-jornadas" style="flex-direction: row; justify-content: center; gap: 5px; margin-bottom: 10px;">
                    <engine:Button name="btn-j1" text="J1" />
                    <engine:Button name="btn-j2" text="J2" />
                    <engine:Button name="btn-j3" text="J3" />
                    <engine:Button name="btn-j4" text="J4" />
                    <engine:Button name="btn-j5" text="J5" />
                </engine:VisualElement>
                <engine:Label text="Puestos Activos" />
                <engine:VisualElement name="puestos-container" style="flex-direction: column; gap: 3px;" />
                <engine:Label text="Margen de Error" style="margin-top: 10px;" />
                <engine:VisualElement style="flex-direction: row; align-items: center;">
                    <engine:Slider name="slider-margen" low-value="1.0" high-value="3" value="1.0" style="flex-grow: 1;" />
                    <engine:Label name="label-margen" text="1.0x" style="margin-left: 10px; width: 40px;" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="recetas-panel" style="flex-direction: column; flex-grow: 1;">
                <engine:Label name="recetas-label" text="Recetas Disponibles" style="unity-text-align: middle-center; font-size: 16px; align-self: center; margin-bottom: 5px;" />
                <engine:ScrollView name="recetas-scroll" style="flex-grow: 1; height: 100%;" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Button name="btn-comenzar" text="COMENZAR SESIÓN" style="height: 40px; margin-top: 10px;" />
    </engine:VisualElement>
</engine:UXML>
