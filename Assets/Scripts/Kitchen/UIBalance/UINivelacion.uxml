<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Kitchen/UIBalance/USSNivelacion.uss?fileID=7433441132597879392&amp;guid=d7a26a7ea0695fa4395df5cab5a021ed&amp;type=3#USSNivelacion" />
    <engine:VisualElement name="root" style="flex-direction: column; padding: 10px; gap: 10px; flex-grow: 1; height: 100%; background-image: resource(&apos;UI/hoja-papel-rayada-ancha-cuaderno_696657-12814&apos;);">
        <engine:Label text="Equilibrio Terapéutico" class="titulo" style="unity-text-align: middle-center; align-items: stretch; align-content: flex-start; align-self: center;" />
        <!--<engine:VisualElement name="form-datos" style="flex-direction: row; justify-content: center; margin-top: 20px; margin-bottom: 20px;">
            <engine:VisualElement style="flex-direction: row; align-items: center; margin-right: 100px;">
                <engine:Label text="Terapeuta:" class="label" style="margin-right: 6px;" />
                <engine:TextField name="field-terapeuta" style="width: 200px;" />
            </engine:VisualElement>
            <engine:VisualElement style="flex-direction: row; align-items: center;">
                <engine:Label text="Paciente:" class="label" style="margin-right: 6px;" />
                <engine:TextField name="field-paciente" style="width: 200px;" />
            </engine:VisualElement>
        </engine:VisualElement>-->
        <engine:VisualElement name="row-container" style="flex-direction: row; justify-content: space-between; gap: 40px; flex-grow: 1;">
            <engine:VisualElement name="jornada-panel" style="flex-direction: column; flex-grow: 1;">
                <engine:VisualElement name="toolbar-jornadas" style="flex-direction: row; justify-content: center; gap: 5px; margin-bottom: 10px;">
                    <engine:Button name="btn-j1" text="J1" class="semititulo" />
                    <engine:Button name="btn-j2" text="J2" class="semititulo" />
                    <engine:Button name="btn-j3" text="J3" class="semititulo" />
                    <engine:Button name="btn-j4" text="J4" class="semititulo" />
                    <engine:Button name="btn-j5" text="J5" class="semititulo" />
                </engine:VisualElement>
                <engine:Label text="Puestos Activos" class="label" />
                <engine:VisualElement name="puestos-container" style="flex-direction: column; gap: 3px;" />
                <engine:VisualElement name="tiempo-config" style="margin-top: 10px;">
                    <engine:Label name="label-tiempo-manual" text="Tiempo: 15m 0s" />
                    <engine:Slider name="slider-tiempo-manual" low-value="600" high-value="1800" value="900" />
                    <engine:Label name="label-dificultad" text="Dificultad: 1.0x" />
                    <engine:Slider name="slider-dificultad" low-value="0.25" high-value="3.0" value="1.0" />
                    <engine:Label name="label-tiempo-total" text="Tiempo final: 15m 0s" style="margin-top: 10px;" class="label"/>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="recetas-panel" style="flex-direction: column; flex-grow: 1;">
                <engine:Label name="recetas-label" text="Recetas Disponibles" class="semititulo" style="unity-text-align: middle-center; align-self: center; margin-bottom: 5px;" />
                <engine:ScrollView name="recetas-scroll" style="flex-grow: 1; height: 100%;" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Button name="btn-comenzar" text="COMENZAR SESIÓN" class="semititulo" style="height: 40px; margin-top: 10px;" />
    </engine:VisualElement>
</engine:UXML>
