.titulo {
    -unity-font-definition: url("project://database/Assets/Fonts/Fredoka-VariableFont_wdth,wght.ttf?fileID=12800000&guid=884662cc446614748ab9b57c22413735&type=3#Fredoka-VariableFont_wdth,wght");
    -unity-font-style: bold;
    font-size: 50px;
}

.semititulo {
    -unity-font-definition: url("project://database/Assets/Fonts/Fredoka-VariableFont_wdth,wght.ttf?fileID=12800000&guid=884662cc446614748ab9b57c22413735&type=3#Fredoka-VariableFont_wdth,wght");
    -unity-font-style: bold;
    font-size: 35px;
}

.label {
    -unity-font-definition: url("project://database/Assets/Fonts/Fredoka-VariableFont_wdth,wght.ttf?fileID=12800000&guid=884662cc446614748ab9b57c22413735&type=3#Fredoka-VariableFont_wdth,wght");
    -unity-font-style: bold;
    font-size: 24px;
}

.toggle {
    font-size: 18px;
}

.toggle > .unity-label {
    min-width: 210px;
    max-width: 210px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.unlock-item {
  flex-direction: column;
  gap: 6px;
  min-width: 260px;
  flex-grow: 1;
}

.unlock-slider-row {
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

#levels-unlocked-slider {
  flex-grow: 1;
  min-width: 200px;
}

.unlock-value {
  width: 32px;
  text-align: center;
  opacity: .8;
  font-size: 18px;
}
