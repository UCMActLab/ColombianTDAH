                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px;">
                            <ui:Toggle label="7pm" name="7pm" value="false" enabled="true" toggle-on-label-click="false" style="height: auto; width: 5%; flex-grow: 1; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0; flex-direction: column;" />
                            <ui:Toggle label="8pm" name="8pm" value="false" style="height: auto; flex-grow: 1; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0; flex-direction: column; width: 5%;" />
