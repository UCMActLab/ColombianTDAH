                            <ui:Toggle label="6am" name="6am" value="true" enabled="true" toggle-on-label-click="false" class="scrolllQs" style="height: auto; width: 5%; flex-grow: 1; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0; flex-direction: column; align-items: stretch;" />
                        </ui:VisualElement>
