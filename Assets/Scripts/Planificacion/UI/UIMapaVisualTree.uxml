<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Planificacion/UI/UIMapaStyleSheet.uss?fileID=7433441132597879392&amp;guid=efb645a9b0d871a44ab44e705572ff67&amp;type=3#UIMapaStyleSheet" />
    <ui:VisualElement name="FullScreen" style="flex-grow: 1; width: 100%; height: 100%; align-items: center; justify-content: center; align-self: center; align-content: center; flex-direction: row; flex-shrink: 0; position: relative; left: 0; top: 0; background-color: rgba(200, 255, 165, 0.53); background-image: url(&quot;project://database/Assets/Sprites/Planificacion/PantallaMapa.jpg?fileID=2800000&amp;guid=337e9b2618757094b95cabb481bc6c60&amp;type=3#PantallaMapa&quot;); display: flex; opacity: 1;">
        <ui:VisualElement name="UiDoc" style="flex-grow: 1; flex-direction: row; background-color: rgba(0, 138, 17, 0); position: relative; top: 0; left: 0; flex-shrink: 1; height: auto; width: auto; max-width: 1080px; max-height: 720px; min-width: 1080px; min-height: 720px; align-content: center; justify-content: space-between; align-items: center; bottom: 0; right: 0;">
            <ui:VisualElement style="flex-grow: 1; left: auto; justify-content: space-between; width: 547px; opacity: 1; background-position-y: center 0;">
                <ui:VisualElement name="Fase1y2" style="flex-grow: 1; flex-direction: column; width: auto; height: 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: -64px;">
                    <ui:VisualElement name="Fase1" class="faseBg" style="flex-grow: 1; margin-bottom: 25px; margin-right: 25px; background-size: 100% 100%; height: 279px;">
                        <ui:IntegerField label="Cant carriles:" value="3" name="carrilesN" style="font-size: 22px;" />
                        <ui:Label text="El máximo es 6. Aunque el número &#10;sea mayor los carriles serán 6." style="flex-wrap: wrap; font-size: 18px;" />
                        <ui:IntegerField label="Cant delf:" value="5" name="delfinesN" style="font-size: 22px;" />
                        <ui:Label text="Aquí aparecerán las&#10;reglas escogidas&#10;anteriormente." style="flex-wrap: wrap; font-size: 22px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Fase2" class="faseBg" style="flex-grow: 1; flex-wrap: wrap; flex-direction: column; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; margin-right: 25px;">
                        <ui:Label text="Atención:                                       ." style="width: 100%; font-size: 22px;" />
                        <ui:VisualElement name="toggleGroup" style="flex-grow: 1;" />
                        <ui:Label text="No se cumplen todos los requisitos." name="delfinesRestantes" style="background-color: rgba(0, 0, 0, 0); font-size: 18px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; height: 541px; width: 383px;" />
            <ui:VisualElement style="flex-grow: 1; right: auto; left: auto; top: auto; width: 860px; height: 561px; bottom: -38px;">
                <ui:VisualElement name="Fase3" class="faseBg" style="flex-grow: 1; width: auto; height: auto; flex-wrap: wrap; justify-content: flex-start; margin-left: 25px;">
                    <ui:ScrollView name="ScrollView" style="font-size: 22px; justify-content: flex-start; align-items: stretch; align-self: center; align-content: stretch;">
                        <ui:VisualElement name="Salida" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgba(255, 121, 121, 0); justify-content: flex-start; height: auto;">
                            <ui:Toggle label="6am" name="6am" value="false" enabled="true" toggle-on-label-click="false" class="scrolllQs" style="height: auto; width: auto; flex-grow: 1; margin-bottom: 6px;" />
                            <ui:Toggle label="7am" name="7am" value="false" enabled="true" toggle-on-label-click="false" style="height: auto; width: auto; flex-grow: 1; margin-bottom: 6px;" />
                            <ui:Toggle label="8am" name="8am" value="false" style="height: auto; flex-grow: 1; margin-bottom: 6px;" />
                            <ui:Toggle label="Seleccionar paradas" name="Paradas" value="false" enabled="true" style="height: auto; flex-grow: 1; margin-bottom: 6px;" />
                            <ui:IntegerField label="Cuándo duerme?" value="3" name="Dormir" max-length="10" style="height: auto; width: auto; align-items: flex-start; justify-content: center; align-content: auto; flex-grow: 1; margin-bottom: 6px;" />
                            <ui:IntegerField label="Cuándo mensaje ubi?" value="2" name="Ubicacion" style="height: auto; flex-grow: 1; margin-bottom: 6px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="Paradas" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgba(255, 121, 121, 0); justify-content: flex-start;">
                            <ui:FloatField label="Velocidad de los objetos:&#10;(entre 0.1 y 20)" value="4.5" name="obstacleVel" max-length="100" style="flex-grow: 1; margin-bottom: 6px;" />
                            <ui:FloatField label="Multiplicador Velocidad:" value="2" name="velFactor" max-length="100" style="flex-grow: 1; flex-direction: row; margin-bottom: 6px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="Dormir" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgba(255, 121, 121, 0); justify-content: flex-start; flex-wrap: wrap; flex-direction: column; align-items: stretch;">
                            <ui:IntegerField label="Puntuacion pirueta:" value="100" name="pointPirueta" style="margin-bottom: 6px;" />
                            <ui:IntegerField label="Puntuacion negativa por clicar en salto: " value="-10" name="pointWrongGuess" style="margin-bottom: 6px;" />
                            <ui:Toggle label="Nivel desbloqueado:" name="desbloqueado" value="true" style="margin-bottom: 6px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="Ubicacion" style="margin-bottom: 6px;">
                            <ui:Button text="Guardar y jugar" name="guardarYjugar" style="flex-grow: 1;" />
                            <ui:Button text="Guardar y volver" name="guardarYvolver" enable-rich-text="true" enabled="false" style="margin-left: 121px; background-color: rgb(255, 148, 48); margin-bottom: 6px;" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
